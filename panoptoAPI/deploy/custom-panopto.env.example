# ==============================================================================
# Custom Panopto API / Cortex Sync Configuration
# Place in /etc/custom-panopto/env with permissions 0640 (root:panopto-sync)
# ==============================================================================

# NC State Unity Credentials (Required)
NCSU_USERNAME=your_unity_id
NCSU_PASSWORD=your_unity_password

# Panopto Base URL
PANOPTO_BASE_URL=https://ncsu.hosted.panopto.com

# Cortex Integration Endpoint & Machine Credential (Required)
CORTEX_BASE_URL=https://cortex.yourdomain.com
CORTEX_CONNECTOR_TOKEN=your_cortex_connector_bearer_token

# Browser Automation Mode ('headless' or 'xvfb')
BROWSER_MODE=headless
BROWSER_PROFILE_DIR=/var/lib/custom-panopto/browser

# Storage Paths
STATE_DB=/var/lib/custom-panopto/state.db
SPOOL_DIR=/var/lib/custom-panopto/spool
LOCK_FILE=/var/lib/custom-panopto/sync.lock
CIRCUIT_BREAKER_FILE=/var/lib/custom-panopto/.auth_locked

# Timeouts & Circuit Breaker Settings
DUO_TIMEOUT_SECONDS=25
MAX_AUTH_ATTEMPTS=3
INITIAL_SYNC_LOOKBACK_DAYS=120
LOG_LEVEL=INFO
