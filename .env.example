# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: openssl rand -base64 32
MOODLE_ENCRYPTION_KEY=

# Credential-free metadata URLs accepted from the Custom Panopto Connector.
PANOPTO_PROVIDER_ORIGIN=https://ncsu.hosted.panopto.com
# Required by owner-scoped diagnostic scripts.
CORTEX_OWNER_ID=

# Canonical deployed endpoint. Required for strict OAuth audience validation.
MCP_RESOURCE_URL=https://cortex.ohmptl.com/api/mcp
# Optional comma-separated browser origins. Server-to-server clients generally omit Origin.
MCP_ALLOWED_ORIGINS=https://chatgpt.com

# Edge Function secrets are configured with `supabase secrets set`, not exposed to Next.js:
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, MOODLE_ENCRYPTION_KEY
